<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>GigaDevice</vendor>
  <url>https://gd32mcu.com/data/documents/pack/</url>
  <name>GD32E51x_DFP</name>
  <description>GigaDevice GD32E51x and GD32EPRTxxA Series Device Support and Examples</description>
  <releases>
   <release version="1.5.0" date="2026-02-26">
    Update firmware library and SVD.
  </release>
   <release version="1.4.0" date="2025-08-19">
    Update firmware library and FLM.
  </release>
   <release version="1.3.2" date="2025-07-25">
    Update flash flm
  </release>
   <release version="1.3.1" date="2025-06-27">
    Add GD32E515CE/GD32E515RE device
  </release>
   <release version="1.3.0" date="2025-02-17">
    Update firmware library and SVD.
  </release>
   <release version="1.2.0" date="2024-08-02">
    Update firmware library.
  </release>
   <release version="1.1.0" date="2024-06-09">
    Release version of GD32E51x and GD32EPRTxxA Device Family Pack.
  </release>
  <release version="1.0.0" date="2023-10-09">
    Release version of GD32E51x and GD32EPRTxxA Device Family Pack.
  </release>
  </releases>
  <keywords>
  <!-- keywords for indexing -->
  <keyword>GigaDevice</keyword>
  <keyword>Device Support</keyword>
  <keyword>GD32E51x</keyword>
  </keywords>
  <devices>
    <family Dfamily="GD32E51x Series" Dvendor="GigaDevice:123">
      <processor Dcore="Cortex-M33" DcoreVersion="r0p4" Dmpu="1" Ddsp="DSP" Dfpu="1" Dendian="Little-endian" />
      <description>
        The GD32E51x(HD:GD32E513;CL:GD32E517,GD32E518) and GD32EPRTxxA device incorporates the Arm Cortex-M33 32-bit processor core operating at up to 180 MHz frequency with Flash accesses 0~4 waiting time to obtain maximum efficiency.
        The device operates from a 1.71 to 3.63 V power supply and available in –40 to +85 temperature range.
      </description>
      <feature type="NVIC"               n="88"                         name="NVIC"/>
      <feature type="XTAL"               n="4000000"    m="32000000"    name="External High Speed Crystal Oscillator"/>
      <feature type="XTAL"               n="32768"                      name="External Low Speed Crystal Oscillator"/>
      <feature type="IntRC"              n="8000000"                    name="Internal 8M RC oscillator"/>
      <feature type="IntRC"              n="48000000"                   name="Internal 48M RC oscillator"/>      
      <feature type="PLL"                n="1"                          name="Internal PLL"/>
      <feature type="PowerMode"          n="4"                          name="Run, Sleep, Deep-Sleep, Standby"/>
      <feature type="PowerOther"         n="4"                          name="POR, PDR, LVD, and BPOR"/>
      <feature type="CoreOther"          n="1"                          name="CRC Calculation Unit"/>
      <feature type="ExtInt"             n="22"                         name="External interrupt"/>            
      <feature type="DMA"                n="12"                         name="General Purpose DMA "/>
      <feature type="Timer"              n="1"          m="24"          name="SysTick Timer"/>
      <feature type="WDT"                n="2"                          name="Watchdog timer"/>
      <feature type="RTC"                n="32000"                      name="Internal RTC"/>
      <feature type="VCC"                n="1.71"       m="3.63"       name="Voltage"/>
      <feature type="Temp"               n="-40"        m="85"          name="Operating Temperature Range"/>
      <feature type="IOs"                n="112"                        name="IO pins"/>
      <feature type="Timer"              n="1"          m="32"          name="General Purpose Timer"/>
      <feature type="Timer"              n="12"         m="16"          name="General Purpose Timer"/>
      <feature type="Timer"              n="3"          m="16"          name="Advanced Timer"/>
      <feature type="Timer"              n="2"          m="16"          name="Basic Timer"/>
      <feature type="USART"              n="4"          m="22500000"    name="USART"/>
      <feature type="UART"               n="2"          m="22500000"    name="UART"/>
      <feature type="I2C"                n="3"                          name="Low-Power I2C"/>
      <feature type="SPI"                n="3"                          name="SPI Interface"/>
      <feature type="I2S"                n="2"                          name="I2S Interface"/>
      <feature type="CAN"                n="2"                          name="CAN2.0B"/>
      <feature type="USBOTG"             n="1"                          name="USBOTG"/>
      <feature type="ETH"                n="1"          m="100000000"   name="ETH"/>
      <feature type="SDIO"               n="1"                          name="SDIO"/>
      <feature type="AnalogOther"        n="3"                          name="COMP"/>
      <feature type="ADC"                n="21"         m="12"          name="High-Performance ADC"/>
      <feature type="DAC"                n="3"          m="12"          name="DAC"/>

<!-- ************************  Subfamily 'GD32E513'  **************************** -->
      <subFamily DsubFamily="GD32E513">
        <processor Dclock="180000000"/>
        <!-- *************************  Device 'GD32E513CC'  ***************************** -->
        <device Dname="GD32E513CC">
          <memory    id="IROM1"                   start="0x08000000" size="0x040000"  startup="1" default="1"/>
          <memory    id="IRAM1"                   start="0x20000000" size="0x18000"   init   ="0" default="1"/>
          <algorithm name="Flash/GD32E51x_256.FLM" start="0x08000000" size="0x040000" default="1"/>
          <compile header="Device/Include/gd32e51x.h" define="GD32E51x_HD"/>
          <debug svd="SVD/GD32E51x_HD.svd"/>
        </device>

        <!-- *************************  Device 'GD32E513CE'  ***************************** -->

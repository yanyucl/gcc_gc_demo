  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="GD32E51xHD">
      <description>GigaDevice GD32E51x Devices</description>
      <require Dvendor="GigaDevice:123" Dname="GD32E513*[CE]*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <!-- Device Conditions -->
    <condition id="GD32E51xCL">
      <description>GigaDevice GD32E51x Devices</description>
      <require Dvendor="GigaDevice:123" Dname="GD32E51[78]**"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <!-- Device Conditions -->
    <condition id="GD32EPRTxxA">
      <description>GigaDevice GD32EPRTxxA Devices</description>
      <require Dvendor="GigaDevice:123" Dname="GD32EPRT*ET6A"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

   <!-- Device + CMSIS Conditions -->
    <condition id="GD32E51x CMSIS">
      <description>GigaDevice GD32E51x Devices and CMSIS-CORE</description>
     <accept condition="GD32E51xHD"/>
     <accept condition="GD32E51xCL"/>
     <accept condition="GD32EPRTxxA"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Cclass="Device" Cgroup="GD32E51x_libopt"/>    
      <require Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="RCU"/>           
      <require Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="PMU"/>    
      <require Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="FMC"/>    
    </condition>


    <!-- GD32E51x STDPERIPHERALS RCU Conditions -->
    <condition id="GD32E51x STDPERIPHERALS RCU">
      <description>GigaDevice GD32E51x Standard Peripherals Drivers with RCU</description>
      <require condition="GD32E51x CMSIS"/>
      <require Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="RCU"/>
    </condition>

     <!-- GD32E51x STDPERIPHERALS MISC Conditions -->
    <condition id="GD32E51x STDPERIPHERALS MISC">
      <description>GigaDevice GD32E51x Standard Peripherals Drivers with MISC</description>
      <require condition="GD32E51x CMSIS"/>
      <require Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="MISC"/>
    </condition>

     <!-- GD32E51x STDPERIPHERALS EVAL Conditions -->
    <condition id="GD32E51x STDPERIPHERALS EVAL">
      <description>GigaDevice GD32E51x Standard Peripherals Drivers with EVAL</description>
      <require condition="GD32E51x CMSIS"/>
      <require Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="GPIO"/>
      <require Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="EXTI"/>
      <require Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="USART"/>
    </condition>
  </conditions>

  <components>
    <!-- GD32E51x_StdPeripherals -->
    <component Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="ADC" Cversion="1.0.0" condition="GD32E51x STDPERIPHERALS RCU">
      <description>Analog-to-digital converter (ADC) driver for GD32E51x Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_ADC
        </RTE_Components_h>
        <files>
          <!-- ADC flie -->
          <file category="header" name="Device/Firmware/Peripherals/inc/gd32e51x_adc.h"/>
          <file category="source" name="Device/Firmware/Peripherals/src/gd32e51x_adc.c" attr="config" version="1.0.0" />
        </files>
    </component>

  <component Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="BKP" Cversion="1.0.0" condition="GD32E51x STDPERIPHERALS RCU">
      <description>Configurable logic array (BKP) driver for GD32E51x Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_BKP
        </RTE_Components_h>
        <files>
          <!-- BKP flie -->
          <file category="header" name="Device/Firmware/Peripherals/inc/gd32e51x_bkp.h" />
          <file category="source" name="Device/Firmware/Peripherals/src/gd32e51x_bkp.c" attr="config" version="1.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="CAN" Cversion="1.0.0" condition="GD32E51x STDPERIPHERALS RCU">
      <description>Controller Area Network (CAN) driver for GD32E51x Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_CAN
        </RTE_Components_h>
        <files>
          <!-- CAN flie -->
          <file category="header" name="Device/Firmware/Peripherals/inc/gd32e51x_can.h" />
          <file category="source" name="Device/Firmware/Peripherals/src/gd32e51x_can.c" attr="config" version="1.0.0" />
        </files>
    </component>
	
   <component Cclass="Device" Cgroup="GD32E51x_StdPeripherals" Csub="CMP" Cversion="1.0.0" condition="GD32E51x STDPERIPHERALS RCU">
      <description>Comparator (CMP) driver for GD32E51x Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_CMP
        </RTE_Components_h>
        <files>
          <!-- CMP flie -->
          <file category="header" name="Device/Firmware/Peripherals/inc/gd32e51x_cmp.h" />
